{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json",
    "paths": {
      "@": [
        "..",
        "./svelte"
      ],
      "@/*": [
        "../*",
        "./svelte/*"
      ],
      "~": [
        "..",
        "./svelte"
      ],
      "~/*": [
        "../*",
        "./svelte/*"
      ],
      "@@": [
        "..",
        "./svelte"
      ],
      "@@/*": [
        "../*",
        "./svelte/*"
      ],
      "~~": [
        "..",
        "./svelte"
      ],
      "~~/*": [
        "../*",
        "./svelte/*"
      ]
    }
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte-check/dist/src/svelte-jsx-v4.d.ts"
  ],
  "include": [
    "../**/*",
    "../.wxt/wxt.d.ts",
    "svelte/.wxt/../**/*",
    "svelte/.wxt/./wxt.d.ts"
  ],
  "exclude": [
    "../**/node_modules",
    "../.output",
    "svelte/.wxt/../**/node_modules",
    "svelte/.wxt/../.output",
    "../entrypoints/dashboard/App.svelte",
    "../entrypoints/dashboard/ConvergenceRail.svelte",
    "../entrypoints/dashboard/NarratorCard.svelte",
    "../entrypoints/dashboard/RunView.svelte",
    "../entrypoints/dashboard/Setup.svelte"
  ]
}