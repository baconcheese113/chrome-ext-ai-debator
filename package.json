{
  "name": "ai-debator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --tsgo --threshold error",
    "postinstall": "wxt prepare",
    "build:e2e": "cross-env WXT_E2E=true wxt build --mode e2e",
    "build:harness": "vite build --config tests/vite.harness.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:driver": "npm run build:harness && playwright test tests/driver",
    "test:e2e": "npm run build:e2e && npm run build:harness && playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:live:login": "node tests/live/login.mjs",
    "test:all": "npm run check && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "cross-env": "^10.1.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
